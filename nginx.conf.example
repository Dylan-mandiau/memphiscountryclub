# Nginx — reverse proxy pour Memphis Country Club (CDC §9.7)
# Placer dans /etc/nginx/sites-available/memphiscountryclub.fr

server {
    listen 80;
    server_name memphiscountryclub.fr www.memphiscountryclub.fr;

    # Redirection HTTPS (après émission Certbot)
    # return 301 https://$host$request_uri;

    client_max_body_size 0;   # AUCUNE LIMITE — règle CDC §10
    proxy_request_buffering off;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}

# Après Certbot, le bloc HTTPS sera ajouté automatiquement.
