{
  "name": "memphiscountryclub",
  "version": "0.1.0",
  "description": "Site vitrine + WebApp PWA — Memphis Country Club",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rimraf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:passenger": "cross-env NODE_ENV=production node server.js",
    "deploy:install": "npm ci --include=dev",
    "deploy:build": "cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=production payload generate:importmap && cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=production next build",
    "lint": "next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "seed": "tsx scripts/seed.ts",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@payloadcms/db-sqlite": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@payloadcms/translations": "^3.0.0",
    "@payloadcms/ui": "^3.0.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "next": "~15.4.11",
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.34.2",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-config-next": "~15.4.11",
    "postcss": "^8.4.47",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "5.6.2"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x"
  }
}
