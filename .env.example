# === Database (PostgreSQL) ===
# Local dev :   postgresql://memphis:changeme@localhost:5432/memphis
# o2switch  :   postgresql://ufaj3133_gremphis:MOT_DE_PASSE@localhost:5432/ufaj3133_memphis
DATABASE_URI=postgresql://memphis:changeme@localhost:5432/memphis

# === Payload ===
PAYLOAD_SECRET=replace-with-a-long-random-secret-string

# Active l'auto-sync du schéma Payload au démarrage (= pas de migrations explicites).
# - Laisse `true` pour le PREMIER déploiement sur une BDD vierge (o2switch).
# - À PASSER À `false` ensuite, et adopter le mode migrate pour les déploiements suivants.
PAYLOAD_PUSH=false

# === Next.js public ===
# Local dev :   http://localhost:3000
# Prod      :   https://new.memphiscountryclub.fr
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# === Node ===
NODE_ENV=development
