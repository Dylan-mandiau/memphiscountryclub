# === Database (SQLite) ===
# Local dev :   file:./memphis.db    (relatif à la racine du projet)
# o2switch  :   file:./memphis.db    (relatif à l'application root)
# Format LibSQL : préfixe "file:" obligatoire pour un fichier local.
DATABASE_URI=file:./memphis.db

# === Payload ===
PAYLOAD_SECRET=replace-with-a-long-random-secret-string

# Active l'auto-sync du schéma Payload au démarrage (= pas de migrations explicites).
# - Laisse `true` pour le PREMIER déploiement sur une BDD vierge (o2switch).
# - À PASSER À `false` ensuite, et adopter le mode migrate pour les déploiements suivants.
PAYLOAD_PUSH=false

# === Next.js public ===
# Local dev :   http://localhost:3000
# Prod      :   https://new.memphiscountryclub.fr
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# === Node ===
NODE_ENV=development
