# .htaccess — à placer dans Application Root sur o2switch
# Le NodeJS Selector ajoute automatiquement les directives Passenger
# (PassengerNodejs, PassengerStartupFile, etc.) — NE PAS y toucher.
# Ce fichier d'exemple contient uniquement les overrides utiles.

# === Désactivation de la limite d'upload (CDC §10 règle 5) ===
LimitRequestBody 0

# === Sécurité headers basiques ===
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# === Cache long pour les assets statiques Next.js ===
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Les requêtes /api, /admin et toutes les pages dynamiques
# passent par Passenger automatiquement — pas de RewriteRule à ajouter.
